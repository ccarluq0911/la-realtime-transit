# API key for Swiftly GTFS-rt
# Register at: https://docs.google.com/forms/d/e/1FAIpQLScy9Jye91QPSTS3WVEU-13es0A1rT9Ep5JhAmXUZEiop7fmIw/viewform
API_KEY=CHANGE_ME

# MySQL (used by both MySQL container and vehicle-producer)
DB_PASSWORD=pass
DB_NAME=vehicles

# Producer-only DB connection (when running outside Docker)
DB_HOST=database
DB_PORT=3306
DB_USER=root

# Kafka KRaft cluster id (keep stable across restarts)
# Generate with: python scripts/generate-kafka-ids.py
KAFKA_CLUSTER_ID=CHANGE_ME

# Kafka KRaft controller directory id for initial cluster bootstrap
# Generate with: python scripts/generate-kafka-ids.py
KAFKA_CONTROLLER_DIRECTORY_ID=CHANGE_ME

# Kafka bootstrap servers (comma-separated)
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:9092,kafka-broker-2:9093

# HDFS namenode address
HDFS_NAMENODE=hdfs://cluster-bda:8020

# GTFS static data path in HDFS
GTFS_DATA_PATH=hdfs:///bda/data/gtfs_bus

# Output paths for processed vehicle data in HDFS
OUTPUT_PATH=${HDFS_NAMENODE}/bda/data/vehicle_delays/
CHECKPOINT_PATH=${HDFS_NAMENODE}/bda/data/vehicle_delays_chck/

# GTFS static data download URL
GTFS_ZIP_URL=https://gitlab.com/LACMTA/gtfs_bus/-/raw/master/gtfs_bus.zip
